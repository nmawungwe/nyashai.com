---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Projects" description="What I’m working on: goveranAI and VhenekAI.">
  <h1>What I’m working on</h1>
  <div class="project-gallery">
    {projects.map((project, index) => (
      <article class="project-feature">
        <span class="project-category">0{index + 1} / {project.category}</span>
        <h2><a href={project.url} target="_blank" rel="noopener noreferrer">{project.title} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></h2>
        <p>{project.description}</p>
        <ProjectPreview project={project} />
      </article>
    ))}
  </div>
</BaseLayout>
