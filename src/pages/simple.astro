---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHomeContent } from '../data/home';
import { projects } from '../data/projects';
import { formatDate } from '../utils';

const { posts, reviews } = await getHomeContent();
---

<BaseLayout title="Simple view">
  <h1>Hi, I’m Nyasha.</h1>
  <p>Building goveranAI and VhenekAI.</p>
  <p><a href="/">Return to the garden ↗</a></p>
  <h2>What I’m working on</h2>
  <div class="cards">
    {projects.map((project) => (
      <a class="card" href={project.url} target="_blank" rel="noopener noreferrer">
        <h3>{project.title} <span aria-hidden="true">↗</span></h3>
        <p>{project.description}</p>
      </a>
    ))}
  </div>
  <h2>Latest writing</h2>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <time class="post-item__meta" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <h3 class="post-item__title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
        <p class="post-item__summary">{post.data.description}</p>
      </li>
    ))}
  </ul>
  <p><a href="/blog/">All writing →</a></p>
  <h2>Recent reviews</h2>
  <ul class="post-list">
    {reviews.map((review) => (
      <li>
        <time class="post-item__meta" datetime={review.data.date.toISOString()}>{formatDate(review.data.date)}</time>
        <h3 class="post-item__title"><a href={`/reviews/${review.id}/`}>{review.data.title}</a></h3>
        <p class="post-item__summary">{review.data.summary}</p>
      </li>
    ))}
  </ul>
  <p><a href="/reviews/">All reviews →</a></p>
</BaseLayout>
