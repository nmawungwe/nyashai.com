---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PavilionPanels from '../components/PavilionPanels.astro';
import desktop from '../assets/pavilion/garden-desktop.webp';
import mobile from '../assets/pavilion/garden-mobile.webp';
import '../styles/pavilion.css';

const responsive = async (src: typeof desktop, widths: number[]) => {
  const sizes = [...new Set([...widths.filter((width) => width < src.width), src.width])];
  const images = await Promise.all(sizes.map((width) => getImage({ src, width, format: 'webp', quality: 85 })));
  return {
    src: images.at(-1)!.src,
    srcset: images.map((image, index) => `${image.src} ${sizes[index]}w`).join(', '),
  };
};
const [landscape, portrait] = await Promise.all([
  responsive(desktop, [960, 1440]),
  responsive(mobile, [480, 720]),
]);
const destinations = [
  { id: 'projects', label: 'Projects', href: '/projects/' },
  { id: 'writing', label: 'Writing', href: '/blog/' },
  { id: 'reviews', label: 'Reviews', href: '/reviews/' },
];
---

<BaseLayout immersive description="Nyasha Mawungwe. Building goveranAI and VhenekAI. Projects, writing, and reviews.">
  <link slot="head" rel="preload" href="/fonts/instrument-serif-regular.ttf" as="font" type="font/ttf" crossorigin />

  <section class="pavilion" aria-labelledby="greeting" style={`--desktop-ratio: ${desktop.width / desktop.height}; --mobile-ratio: ${mobile.width / mobile.height};`}>
    <div class="scene-viewport">
      <div class="scene-plane">
        <picture>
          <source media="(max-aspect-ratio: 1/1)" srcset={portrait.srcset} sizes="100vw" width={mobile.width} height={mobile.height} />
          <img src={landscape.src} srcset={landscape.srcset} sizes="100vw" width={desktop.width} height={desktop.height} alt="A sunlit garden pavilion, with a laptop on a wooden table, an open notebook, and books on a reading bench." fetchpriority="high" loading="eager" decoding="async" />
        </picture>

        <nav class="scene-links" aria-label="Explore my work">
          {destinations.map((item) => (
            <a class={`scene-hotspot hotspot-${item.id}`} href={item.href} data-panel={item.id}>
              <span class="hotspot-label">{item.label}</span>
              <span class="hotspot-line" aria-hidden="true"></span>
              <span class="hotspot-dot" aria-hidden="true"></span>
            </a>
          ))}
        </nav>
      </div>
    </div>

    <header class="pavilion-header">
      <a class="pavilion-brand" href="/" aria-label="Nyasha Mawungwe — home">Nyasha Mawungwe</a>
      <a class="pavilion-about" href="/about/">About <span aria-hidden="true">↗</span></a>
      <details class="pavilion-menu">
        <summary aria-label="Navigation menu">
          <svg class="menu-open" width="26" height="20" viewBox="0 0 26 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 2h26M0 10h26M0 18h26" /></svg>
          <svg class="menu-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 5 14 14M5 19 19 5" /></svg>
        </summary>
        <nav aria-label="Mobile navigation">
          <a href="/about/">About <span aria-hidden="true">↗</span></a>
          {destinations.map((item) => <a href={item.href} data-panel={item.id}>{item.label} <span aria-hidden="true">↗</span></a>)}
          <a href="/simple/">Simple view <span aria-hidden="true">↗</span></a>
        </nav>
      </details>
    </header>

    <div class="pavilion-intro">
      <h1 id="greeting">Hi, I’m Nyasha.</h1>
      <p>Building <a href="https://www.goveranai.com/en" target="_blank" rel="noopener noreferrer">goveranAI</a> and <a href="https://vhenekai.org/" target="_blank" rel="noopener noreferrer">VhenekAI</a>.</p>
    </div>

    <a class="pavilion-simple" href="/simple/">Simple view <span aria-hidden="true">↗</span></a>

    <nav class="pavilion-mobile-links" aria-label="Explore my work">
      {destinations.map((item) => <a href={item.href} data-panel={item.id}>{item.label}</a>)}
    </nav>
  </section>

  <PavilionPanels />
</BaseLayout>

<script>
  import '../scripts/pavilion';
</script>
