---
import { site, nav } from '../site';
const { pathname } = Astro.url;
// Mark the active tab. "/" only matches home exactly; others match their section.
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <nav class="nav" aria-label="Primary">
      <a class="nav__brand" href="/">{site.name}</a>
      <div class="nav__right">
        <div class="nav__links">
          {nav.map((item) => (
            <a
              href={item.href}
              class={isActive(item.href) ? 'is-active' : ''}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </div>
        <button
          class="theme-toggle"
          type="button"
          aria-label="Toggle dark mode"
          title="Toggle light / dark mode"
        >
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 14.2A8.5 8.5 0 0 1 9.8 4a8.5 8.5 0 1 0 10.2 10.2Z" /></svg>
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
        </button>
      </div>
    </nav>
  </div>
</header>
