---
import '../styles/global.css';
import '../styles/reading.css';
import { Image } from 'astro:assets';
import garden from '../assets/pavilion/garden-desktop-personal.webp';
import Nav from '../components/Nav.astro';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  immersive?: boolean;
  returnHref?: string;
  returnLabel?: string;
}

const { title, description = site.description, immersive = false, returnHref = '/', returnLabel = 'Back to the garden' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-pavilion={immersive || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Open Graph / social cards -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <meta name="generator" content={Astro.generator} />
    <slot name="head" />

    <!-- Apply the saved theme before paint to avoid a flash of the wrong mode. -->
    <script is:inline>
      (function () {
        if (document.documentElement.hasAttribute('data-pavilion')) return;
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.dataset.theme = t;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={immersive ? 'pavilion-page' : 'reading-page'}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {!immersive && <Nav />}
    {!immersive && Astro.url.pathname.replace(/\/$/, '') !== '/simple' && <div class="reading-landscape" aria-hidden="true">
      <Image src={garden} alt="" width={1440} quality={75} loading="eager" />
    </div>}
    <main id="main-content" class={immersive ? 'pavilion-main' : 'wrap reading-main'}>
      {!immersive && <a class="garden-return" href={returnHref}>← {returnLabel}</a>}
      <slot />
    </main>
    {!immersive && <footer class="site-footer">
      <div class="wrap">
        <div class="social">
          {site.socials.map((s) => (
            <a href={s.href} target={s.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer">
              {s.label}
            </a>
          ))}
        </div>
        <p>© {year} {site.name}</p>
      </div>
    </footer>}

    <!-- Theme toggle: warm paper by default, with a saved dark reading mode. -->
    <script is:inline>
      (function () {
        var btn = document.querySelector('.theme-toggle');
        if (!btn) return;

        function current() {
          var set = document.documentElement.dataset.theme;
          if (set === 'light' || set === 'dark') return set;
          return 'light';
        }
        function render() {
          var c = current();
          // Show the mode you'd switch TO.
          btn.setAttribute(
            'aria-label',
            c === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
          );
        }
        btn.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          render();
        });
        render();
      })();
    </script>
  </body>
</html>
